{
  "name": "pokemap-widget",
  "version": "0.1.0",
  "description": "Нужно сделать виджет: карта города с точками из OpenStreetMap, которые игрок собирает, подходя к ним ближе заданного радиуса. Виджет поставляется одним JS-файлом и встраивается в чужую страницу, которую вы не контролируете.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n build,serve -c cyan,green \"vite build --watch --mode development\" \"node scripts/server.mjs\"",
    "build": "npm run lint && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:style": "esbuild scripts/check-style.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.tmp/check-style.mjs && node node_modules/.tmp/check-style.mjs",
    "check:http": "esbuild scripts/check-http.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.tmp/check-http.mjs && node node_modules/.tmp/check-http.mjs",
    "check:game": "esbuild scripts/check-game.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.tmp/check-game.mjs && node node_modules/.tmp/check-game.mjs",
    "check:data": "esbuild scripts/check-data.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.tmp/check-data.mjs && node node_modules/.tmp/check-data.mjs",
    "check": "npm run check:style && npm run check:http && npm run check:game && npm run check:data"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadxwkxw/fe-testcase-2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/shadxwkxw/fe-testcase-2026/issues"
  },
  "homepage": "https://github.com/shadxwkxw/fe-testcase-2026#readme",
  "private": "true",
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.11"
  }
}
